# ============================================================
# 1. FOR DEVELOPMENT
# ============================================================
NODE_ENV=development
PORT=3001

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/dormiway
MONGODB_DB_NAME=dormiway

# JWT Authentication (Development)
JWT_SECRET=replace_with_a_long_random_hex_secret_for_development
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d

# CORS (Development)
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3001


# ============================================================
# 2. FOR PRODUCTION (Uncomment & set in your hosting env vars)
# ============================================================
# NODE_ENV=production
# PORT=3001
#
# # MongoDB Connection (Production)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# MONGODB_DB_NAME=dormiway
#
# # JWT Authentication (Production)
# JWT_SECRET=replace_with_a_different_long_random_hex_secret_for_production
# JWT_EXPIRES_IN=2h
# JWT_REMEMBER_EXPIRES_IN=14d
#
# # CORS (Production)
# ALLOWED_ORIGIN=https://dormiway.vercel.app
